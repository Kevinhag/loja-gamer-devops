# Copie para /opt/lojagamer/.env na EC2 (o setup-ec2.sh já faz isso) e preencha.
# Este arquivo NÃO vai para o Git: ele guarda as senhas do ambiente de produção.

# --- Banco: endpoint do Amazon RDS (MySQL) ---
DB_HOST=lojagamer-db.xxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=troque-esta-senha
DB_NAME=lojagamer
# O RDS aceita TLS; "preferred" usa TLS sem exigir o certificado da AWS instalado.
DB_TLS=preferred

# --- Imagens dos produtos: Amazon S3 ---
STORAGE_DRIVER=s3
S3_BUCKET=lojagamer-imagens-seunome
S3_PREFIX=products/
AWS_REGION=us-east-1
# Na EC2 as credenciais vêm da IAM Role da instância (LabInstanceProfile no AWS Academy).
# Só preencha as linhas abaixo se a instância NÃO tiver role:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# --- Aplicação ---
# Token para entrar em /admin. Gere um aleatório: openssl rand -hex 24
ADMIN_TOKEN=troque-este-token
LOG_LEVEL=info
MIGRATE=true

# --- Opcional: enviar os logs do container para o CloudWatch Logs ---
# Lido pelo deploy.sh (não pela aplicação). Deixe vazio para usar só "docker logs".
CLOUDWATCH_LOG_GROUP=
